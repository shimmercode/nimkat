# Apply these variables using your shell or service manager.
# The API does not automatically load .env files.
NODE_ENV=development
PORT=8000

# Mandatory in production: generate a random value of at least 32 characters.
# NIMKAT_SECRET=
# Production always requires Secure cookies and HTTPS at the reverse proxy.
# COOKIE_SECURE=true
# Comma-separated exact browser origins, no wildcard.
# APP_ORIGINS=https://your-domain.ir
# Set only for a controlled proxy that overwrites client-supplied forwarded headers.
# TRUST_PROXY=loopback

# Optional isolated test/development DB directory.
# NIMKAT_DATA_DIR=/absolute/path/to/test-data

# A real SMS adapter must be wired into the auth module before production OTP works.
# No devCode or OTP logs are emitted in production.

# Required in production: 64 hex chars, back up separately; never commit real values.
NIMKAT_SETTINGS_KEY=
# Canonical HTTPS origin for payment callback (no trailing path required).
PUBLIC_SITE_URL=
# Optional locally/self-hosted support model. No browser access needed.
OLLAMA_URL=http://127.0.0.1:11434

# Embedded HTTPS preview only (keep SameSite=lax on standalone production unless needed).
# Secure cookies are mandatory for SameSite=None and Partitioned.
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none
# COOKIE_PARTITIONED=true

# Private ClamAV INSTREAM for educational materials. Keep TCP/3310 off the public internet.
# Enable the materials service and set storage budgets in admin after staging acceptance.
# Missing/disabled/erroring scanner refuses uploads; there is no mock-clean fallback.
# NIMKAT_CLAMD_HOST=127.0.0.1
# NIMKAT_CLAMD_PORT=3310
