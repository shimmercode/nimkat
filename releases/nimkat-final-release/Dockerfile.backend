FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app/backend
COPY backend/package.json backend/package-lock.json ./
RUN npm ci --omit=dev
COPY backend/src ./src
RUN mkdir -p /app/backend/data && chown -R node:node /app/backend
USER node
ENV NODE_ENV=production
ENV PORT=8000
ENV NIMKAT_DB_PATH=/app/backend/data/nimkat.db
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8000/api/health || exit 1
CMD ["node", "src/server.js"]
