# Apply these variables using your shell or service manager.
# The API does not automatically load .env files.
NODE_ENV=development
PORT=8000

# Mandatory in production: generate a random value of at least 32 characters.
# NIMKAT_SECRET=
# Production always requires Secure cookies and HTTPS at the reverse proxy.
# COOKIE_SECURE=true
# Comma-separated exact browser origins, no wildcard.
# APP_ORIGINS=https://your-domain.ir
# Set only for a controlled proxy that overwrites client-supplied forwarded headers.
# TRUST_PROXY=loopback

# Optional isolated test/development DB directory.
# NIMKAT_DATA_DIR=/absolute/path/to/test-data

# A real SMS adapter must be wired into the auth module before production OTP works.
# No devCode or OTP logs are emitted in production.
