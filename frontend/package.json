{
  "name": "nimkat-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Nimkat — Next.js App Router, RTL educational platform",
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0 --port 5173",
    "build": "next build --webpack",
    "start": "node -e \"const {spawn}=require('child_process');spawn(process.execPath,['./node_modules/next/dist/bin/next','start','--hostname','0.0.0.0','--port',process.env.PORT||'5173'],{stdio:'inherit'}).on('exit',c=>process.exit(c||0))\"",
    "start:3000": "next start --hostname 0.0.0.0 --port 3000",
    "start:web": "node scripts/start-web.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "motion": "^14.4.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "vitest": "^5.0.5"
  }
}
