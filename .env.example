# Nimkat Platform — Environment Variables Example (.env.example)
# Copy this file to .env for local development. Never commit real secrets or .env files.

# Server & Environment
NODE_ENV=development
PORT=3001
NIMKAT_DATA_DIR=./backend/data
NIMKAT_PUBLIC_ORIGIN=http://localhost:3000

# Authentication & Security Secrets (Required in production: min 32 random bytes)
NIMKAT_AUTH_SECRET=replace-with-at-least-32-character-random-secret-in-production
NIMKAT_SETTINGS_KEY=replace-with-32-byte-base64-or-hex-key-for-provider-settings

# Payment Gateway (Optional in development: defaults to controlled local_dev simulator when unset)
# In production, configure via Admin > Integrations or provider settings:
# ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ZARINPAL_SANDBOX=true

# Frontend Public API Base
NEXT_PUBLIC_API_BASE=/api
