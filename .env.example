# Nimkat 1.7.0 Environment Configuration Example
# Copy this file to .env for local development or production deployment.
# NEVER commit a real .env file containing live secrets.

NODE_ENV=development
PORT=8000
NIMKAT_DATA_DIR=./data

# Authentication HMAC secret (Required in production; minimum 32 characters)
NIMKAT_SECRET=nimkat-dev-secret-change-in-production-min-32-chars

# Provider settings AES-256-GCM encryption key (Required in production; MUST be exactly 64 hex characters)
NIMKAT_SETTINGS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Public origins and canonical URLs
PUBLIC_SITE_URL=http://localhost:5173
SITE_URL=https://nimkat.ir
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_INTERNAL_URL=http://127.0.0.1:8000

# Cookie security policy (In production, COOKIE_SECURE is enforced as true)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_PARTITIONED=false

# Reverse proxy & ClamAV scanner (optional in development)
TRUST_PROXY=
NIMKAT_CLAMD_HOST=127.0.0.1
NIMKAT_CLAMD_PORT=3310
