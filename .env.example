# Nimkat Platform — Root Environment Configuration Example
# See backend/.env.example and frontend/.env.example for service-specific details.

NODE_ENV=development
PORT=8000
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_TELEMETRY_DISABLED=1

# Production security & session secrets (mandatory in NODE_ENV=production):
# NIMKAT_SECRET=replace-with-at-least-32-character-random-secret
# NIMKAT_SETTINGS_KEY=replace-with-64-hex-characters
# COOKIE_SECURE=true
# APP_ORIGINS=https://nimkat.ir
# PUBLIC_SITE_URL=https://nimkat.ir
# SITE_URL=https://nimkat.ir
# NIMKAT_DATA_DIR=/home/user/nimkat/backend/data
